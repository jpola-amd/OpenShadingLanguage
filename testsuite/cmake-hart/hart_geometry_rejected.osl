#ifndef GEOMETRY_WRITE_TIME
#define GEOMETRY_WRITE_TIME 0
#endif

shader hart_geometry_rejected(int enabled = 0, output color Cout = 0)
{
    if (enabled) {
#if GEOMETRY_WRITE_TIME
        // oslc warns about this write; HART must reject the emitted opcode too.
        time = u;
#else
        I[0] = u;
#endif
    }
    Cout = color(u, v, 0);
}
