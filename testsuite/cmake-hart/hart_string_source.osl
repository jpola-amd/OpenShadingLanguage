shader hart_string_source(string text = "alpha", output string value = "",
                         output string words[3] = {"", "", ""})
{
    value = u > .5 ? text : "red";
    words[0] = value;
    words[1] = "literal";
    words[2] = v > .5 ? "" : text;
}
