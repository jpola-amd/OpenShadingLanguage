#define PERLIN(...) noise("perlin", __VA_ARGS__)
#define UPERLIN(...) noise("uperlin", __VA_ARGS__)
#define CELL(...) noise("cell", __VA_ARGS__)
#define HASH(...) noise("hash", __VA_ARGS__)
#define SIMPLEX(...) noise("simplex", __VA_ARGS__)
#define USIMPLEX(...) noise("usimplex", __VA_ARGS__)
#define PPERLIN(...) pnoise("perlin", __VA_ARGS__)
#define PUPERLIN(...) pnoise("uperlin", __VA_ARGS__)
#define PCELL(...) pnoise("cell", __VA_ARGS__)
#define PHASH(...) pnoise("hash", __VA_ARGS__)

#define SAMPLE_NOISE(function, result) \
    if (d == 1)                       \
        result = function(x);         \
    else if (d == 2)                  \
        result = function(x, y);      \
    else if (d == 3)                  \
        result = function(q);         \
    else                             \
        result = function(q, w);

#define SAMPLE_PERIODIC(function, result)                  \
    if (d == 1)                                           \
        result = function(x, period[0]);                  \
    else if (d == 2)                                      \
        result = function(x, y, period[0], period[1]);     \
    else if (d == 3)                                      \
        result = function(q, period);                     \
    else                                                 \
        result = function(q, w, period, period_w);

#define EVALUATE_NOISE(TYPE)                               \
    TYPE n = 0;                                          \
    if (periodic) {                                      \
        if (family == 0) {                               \
            if (named) { SAMPLE_PERIODIC(PPERLIN, n) }   \
            else { SAMPLE_PERIODIC(psnoise, n) }         \
        } else if (family == 1) {                        \
            if (named) { SAMPLE_PERIODIC(PUPERLIN, n) }  \
            else { SAMPLE_PERIODIC(pnoise, n) }          \
        } else if (family == 2) {                        \
            SAMPLE_PERIODIC(PCELL, n)                    \
        } else {                                        \
            SAMPLE_PERIODIC(PHASH, n)                    \
        }                                               \
    } else if (family == 0) {                            \
        if (named) { SAMPLE_NOISE(PERLIN, n) }            \
        else { SAMPLE_NOISE(snoise, n) }                 \
    } else if (family == 1) {                            \
        if (named) { SAMPLE_NOISE(UPERLIN, n) }           \
        else { SAMPLE_NOISE(noise, n) }                  \
    } else if (family == 2) {                            \
        if (named) { SAMPLE_NOISE(CELL, n) }              \
        else { SAMPLE_NOISE(cellnoise, n) }              \
    } else if (family == 3) {                            \
        if (named) { SAMPLE_NOISE(HASH, n) }              \
        else { SAMPLE_NOISE(hashnoise, n) }              \
    } else if (family == 4) {                            \
        SAMPLE_NOISE(SIMPLEX, n)                         \
    } else {                                            \
        SAMPLE_NOISE(USIMPLEX, n)                        \
    }                                                   \
    Cout = color(n);

shader hart_noise_families(int periodic = 0, int named = 0, int shift = 0,
                           int canonical_periods = 0,
                           float offset_u = 0, float offset_v = 0,
                           output color Cout = 0)
{
    // The 65x33 matrix packs dimensions in columns and families/return types
    // in rows. Exact binary coordinates matter for hashnoise's float bits.
    int column = int(64 * u);
    int row = int(32 * v);
    int d = 1 + int(u >= 0.25) + int(u >= 0.5) + int(u >= 0.75);
    int kind = row / 11;
    int family = (row - 11 * kind) / (periodic ? 3 : 2);
    int probe = column - 16 * (d - 1);
    float base = (probe - 8) / 4.0;
    if (probe < 3)
        base = -2 + (probe - 1) / 1024.0;
    else if (probe >= 14)
        base = 2 + (probe - 15) / 1024.0;
    point period = point(2, 4, 8);
    float period_w = 16;
    if (probe >= 3 && probe <= 5) {
        period = point(1);
        period_w = 1;
    }
    point shift_period = period;
    float shift_w = period_w;
    // Compare raw periods against independently specified max(1, floor(p))
    // periods in the named-alias pass, without adding another render.
    if (!canonical_periods) {
        if (probe >= 3 && probe <= 5) {
            float p = probe == 3 ? -2 : (probe == 4 ? 0 : 0.75);
            period = point(p);
            period_w = p;
        } else if (probe == 6) {
            period += point(0.75);
            period_w += 0.75;
        }
    }
    // Discrete base positions include negative/positive period seams and
    // immediate neighbors. Residuals retain small, nonzero Dx/Dy for FD checks.
    float s = u - column / 64.0 + offset_u;
    float t = v - row / 32.0 + offset_v;
    float x = base + 0.5 * s + 0.125 * t + shift_period[0] * shift;
    float y = 2 * base + 0.25 * s - 0.5 * t + shift_period[1] * shift;
    float z = 4 * base + 0.125 * s + 0.25 * t + shift_period[2] * shift;
    float w = 8 * base + 0.5 * s + 0.25 * t + shift_w * shift;
    if (family >= 4) {
        // Offset simplex probes away from lattice/ranking boundaries.
        x += 0.0625;
        y += 0.1875;
        z -= 0.3125;
        w += 0.4375;
    }
    point q = point(x, y, z);
    if (kind == 0) {
        EVALUATE_NOISE(float)
    } else if (kind == 1) {
        EVALUATE_NOISE(color)
    } else {
        EVALUATE_NOISE(vector)
    }
}
