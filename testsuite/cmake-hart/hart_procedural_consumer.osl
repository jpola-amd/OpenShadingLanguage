shader hart_procedural_consumer(color value = 0, int recipe = 0,
                               int filtered = 1, int report = 0,
                               output color Cout = 0)
{
    float weight = 0;
    if (recipe == 0)
        weight = smoothstep(-0.5, 0.5, value[0]);
    else if (recipe == 1)
        weight = 0.75 * value[0] + 0.25 * value[1];
    else if (filtered) {
        // Explicit footprint filtering, not automatic noise filtering.
        // filterwidth's own derivatives are zero.
        float width = filterwidth(value[0]);
        weight = smoothstep(0.03125 - width, 0.03125 + width, value[0]);
    } else
        weight = step(0.03125, value[0]);
    color ramp = mix(color(0.125, 0.25, 0.75), color(0.875, 0.625, 0.125),
                     weight);
    if (report == 0)
        Cout = ramp;
    else {
        // Select all RGB components, with the same probe at both tile edges.
        int component = int(3 * u) - 3 * int(u);
        float sample = ramp[0];
        if (component == 1)
            sample = ramp[1];
        else if (component == 2)
            sample = ramp[2];
        Cout = color(sample, Dx(sample), Dy(sample));
    }
}
