#define EVALUATE_PAIR(FROM, TO, TYPE)                                \
    TYPE q = TYPE(value[0] + 0.25 * gain, value[1] - 0.5 * gain,      \
                  value[2] + 0.125 * gain);                         \
    TYPE result = 0;                                               \
    matrix m = matrix(1);                                          \
    int ok = 1;                                                    \
    if (operation == 0)                                            \
        result = transform(FROM, TO, q);                           \
    else if (operation == 1) {                                     \
        m = matrix(FROM, TO);                                      \
        result = transform(m, q);                                  \
    } else if (operation == 2) {                                   \
        ok = getmatrix(FROM, TO, m);                               \
        result = transform(m, q);                                  \
    } else if (operation == 3) {                                   \
        TYPE p = TYPE(FROM, q[0], q[1], q[2]);                      \
        result = transform(TO, p);                                 \
    } else if (operation == 4) {                                   \
        m = matrix(FROM, 1 + gain) * matrix("common", TO);           \
        result = transform(m, q);                                  \
    } else {                                                      \
        m = matrix(FROM, 1 + gain, 0.25, 0, 0, 0, 2, 0, 0,         \
                   0, 0, 0.5, 0, 0.25, -0.125, 0.375, 1)         \
            * matrix("common", TO);                                \
        result = transform(m, q);                                  \
    }                                                             \
    if (report == 2)                                               \
        Cout = color(ok, determinant(m), m[3][0]);                  \
    else {                                                        \
        color rgb = color(result);                                \
        if (report == 0)                                           \
            Cout = rgb;                                           \
        else {                                                    \
            float sample = rgb[0];                                \
            if (component == 1)                                   \
                sample = rgb[1];                                  \
            else if (component == 2)                              \
                sample = rgb[2];                                  \
            Cout = color(sample, Dx(sample), Dy(sample));           \
        }                                                         \
    }

#define SAMPLE_PAIRS(TYPE)                                         \
    if (pair == 0) { EVALUATE_PAIR("common", "common", TYPE) }       \
    else if (pair == 1) { EVALUATE_PAIR("common", "object", TYPE) }  \
    else if (pair == 2) { EVALUATE_PAIR("common", "shader", TYPE) }  \
    else if (pair == 3) { EVALUATE_PAIR("object", "common", TYPE) }  \
    else if (pair == 4) { EVALUATE_PAIR("object", "object", TYPE) }  \
    else if (pair == 5) { EVALUATE_PAIR("object", "shader", TYPE) }  \
    else if (pair == 6) { EVALUATE_PAIR("shader", "common", TYPE) }  \
    else if (pair == 7) { EVALUATE_PAIR("shader", "object", TYPE) }  \
    else { EVALUATE_PAIR("shader", "shader", TYPE) }

shader hart_space_consumer(color value = 0, float gain = 0.5, int report = 0,
                           output color Cout = 0)
{
    // 65x33 packs nine literal pairs, six APIs, and three spatial types.
    int pair = min(int(9 * u), 8);
    int row = int(32 * v);
    int kind = row / 11;
    int operation = (row - 11 * kind) / 2;
    int column = int(64 * u);
    int component = column - 3 * (column / 3);
    if (kind == 0) {
        SAMPLE_PAIRS(point)
    } else if (kind == 1) {
        SAMPLE_PAIRS(vector)
    } else {
        SAMPLE_PAIRS(normal)
    }
}
