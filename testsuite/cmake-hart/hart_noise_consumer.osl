shader hart_noise_consumer(color value = 0, int report = 1, int component = -1,
                           int arithmetic = 0, float offset_u = 0,
                           float offset_v = 0, output color Cout = 0)
{
    color n = value;
    if (arithmetic) {
        float s = u + offset_u;
        float t = v + offset_v;
        n = n * color(0.73, -1.19, 1.37)
            + color(0.11 * s, 0.07 * s * t, -0.13 * t);
    }
    int c = component;
    if (c < 0) {
        int probe = int(11.99 * u);
        c = probe - 3 * (probe / 3);
    }
    float sample = n[0];
    if (c == 1)
        sample = n[1];
    else if (c == 2)
        sample = n[2];
    if (report == 0)
        Cout = n;
    else if (report == 1)
        Cout = color(sample, Dx(sample), Dy(sample));
    else if (report == 2)
        Cout = color(filterwidth(vector(n)));
    else
        Cout = color(filterwidth(sample), 0, 0);
}
